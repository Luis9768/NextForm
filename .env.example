# ==============================================================================
# NEXFORM - Exemplo de Variáveis de Ambiente (.env.example)
# Copie para .env ou cole nas Environment Variables do Easypanel
# ==============================================================================

# 1. Super Admin Inicial (Provisionado automaticamente no boot com banco zerado)
APP_BOOTSTRAP_ADMIN_NAME=Super Admin NextForm
APP_BOOTSTRAP_ADMIN_EMAIL=supernext@gmail.com
APP_BOOTSTRAP_ADMIN_PASSWORD=change_this_admin_password

# 2. Senha Única de 1º Acesso para colaboradores importados do Directus
APP_FIRST_ACCESS_PASSWORD=change_this_first_access_password

# 3. Cloudflare R2 Object Storage (Armazenamento S3 de Áudios)
R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=nextform-audios
R2_ACCESS_KEY_ID=change_this_r2_access_key_id
R2_SECRET_ACCESS_KEY=change_this_r2_secret_access_key
R2_REGION=auto
R2_PUBLIC_URL=

# 4. Banco de Dados PostgreSQL
POSTGRES_DB=formshq
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
SERVER_PORT=8080
DATABASE_URL=jdbc:postgresql://postgres:5432/formshq
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_me

# 5. Segurança JWT & API Key
JWT_SECRET=change_this_secret_key_in_production_min_256_bits
JWT_EXPIRATION_MS=86400000
N8N_API_KEY=change_this_n8n_api_key

# 6. Integrações Externas (Directus & Webhooks n8n)
DIRECTUS_BASE_URL=https://seu-directus.exemplo.com
DIRECTUS_API_TOKEN=change_this_directus_static_token
CUSTOMER_WEBHOOK_URL=https://seu-servidor-n8n.exemplo.com/webhook/buscar-dados-directus
AUDIO_EVALUATION_WEBHOOK_URL=https://seu-servidor-n8n.exemplo.com/webhook/avaliacao-audio-aquisicao
SAC_RETENCAO_WEBHOOK_URL=https://seu-servidor-n8n.exemplo.com/webhook/sac-retencao-ticket

# 7. Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_CUSTOMER_WEBHOOK_URL=https://seu-servidor-n8n.exemplo.com/webhook/buscar-dados-directus
